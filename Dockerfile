# Используем официальный образ Python 3.11 (легкий)
FROM python:3.12-slim

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Устанавливаем системные зависимости (для некоторых пакетов могут понадобиться)
# Для SQLite и других базовых вещей ничего дополнительно не требуется

# Копируем файл с зависимостями и устанавливаем их
COPY req.txt .
RUN pip install --no-cache-dir -r req.txt

# Копируем весь проект в контейнер
COPY . .

# Создаём папку для базы данных (если нужно) – по умолчанию SQLite создаст файл в /app
# Можно также указать том для сохранения базы данных

# Открываем порт (обычно 5000 или 8000)
EXPOSE 5000

# Запускаем приложение через Gunicorn (рекомендуется для продакшена)
# Если хотите использовать встроенный сервер Flask (для разработки), замените команду
CMD ["gunicorn", "--bind=0.0.0.0:5000", "main:app"]